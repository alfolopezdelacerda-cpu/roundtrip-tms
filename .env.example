# Copiar a .env.local y rellenar. NUNCA commitear .env.local.
# El backend valida estas variables al arrancar (Joi en AppModule): si falta
# un secreto obligatorio o es demasiado corto, el proceso no levanta.

NODE_ENV=development
API_PORT=3000

# --- PostgreSQL (3 instancias) ---
POSTGRES_USER=roundtrip
POSTGRES_PASSWORD=
DB_TRANSPORTES_URL=postgresql://roundtrip:CHANGEME@localhost:5432/transportes_db
DB_FORWARDING_URL=postgresql://roundtrip:CHANGEME@localhost:5433/forwarding_db
DB_MONITOREO_URL=postgresql://roundtrip:CHANGEME@localhost:5434/monitoreo_db
# Solo desarrollo: crea el esquema desde las entidades. En producción se
# ignora — ahí el esquema solo cambia por migraciones.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# --- Redis ---
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Keycloak ---
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=roundtrip-tms
KEYCLOAK_CLIENT_ID=roundtrip-backend
KEYCLOAK_CLIENT_SECRET=

# --- Criptografía (mínimo 32 caracteres cada uno) ---
JWT_SECRET=
JWT_EXPIRATION=900s
# Secreto propio para el refresh token: si se filtra el de acceso, no se
# pueden emitir sesiones nuevas. Si se omite, cae en JWT_SECRET.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=

# --- MFA ---
MFA_ISSUER=Roundtrip TMS

# --- CORS / frontend ---
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Logs ---
LOG_LEVEL=debug
